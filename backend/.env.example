# 复制本文件为 .env 并修改以下配置（.env 已被 gitignore，不会上传）

# 管理员口令：前端调用管理接口时通过请求头 X-Admin-Token 携带
ADMIN_TOKEN=请设置一个强口令

# Flask 密钥（可选，用于会话等；非必填）
SECRET_KEY=please-change-me

# Supabase（可选）：配置后后端可校验用户登录令牌。
# 建好 Supabase 项目后，在 Dashboard -> Settings -> API 中获取。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
